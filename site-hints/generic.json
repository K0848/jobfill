  "preventMix": [
    {
      "from": "学历",
      "mustNotMap": "academicDegree",
      "reason": "学历层次不能当成已获得学位"
    },
    {
      "from": "学历类型",
      "correctKey": "studyForm",
      "wrongKey": "degree",
      "reason": "学历类型表达修读形式，不是学历层次"
    },
    {
      "from": "学校所在地",
      "mustNotMap": "city",
      "reason": "学校所在地不能当成现居城市"
    },
    {
      "from": "工作职责",
      "correctKey": "responsibilities",
      "wrongKey": "description",
      "reason": "职责是限字职责源，不能用完整描述替代"
    },
    {
      "from": "身高",
      "rejectWithout": "单位标注（厘米或英寸）",
      "reason": "没有单位时不推算公制值"
    },
    {
      "from": "体重",
      "rejectWithout": "单位标注（公斤或磅）",
      "reason": "没有单位时不推算公制值"
    },
    {
      "from": "项目职务/项目角色",
      "correctKey": "project[].role",
      "wrongKey": "work[].role",
      "reason": "项目内的职务取该项目自身 role（如独立开发者），不得取工作经历岗位名称或自拟职位"
    },
    {
      "from": "培养方式",
      "mustNotMap": "studyForm",
      "reason": "培养方式可能指定向/非定向（如“非定向（统招、并轨）”），与学习形式（全日制/非全日制）不同，须按页面选项集判断后再映射"
    },
    {
      "from": "期望工作地点",
      "mustNotMap": "preferredWorkCity",
      "reason": "飞书租户的「期望工作地点」是「国家/地区 → 省 → 市」多选树，顶层是国家/地区而非城市；不能用城市级偏好（preferredWorkCity/city）直接映射，须先看控件顶层语义"
    },
    {
      "from": "期望工作地点",
      "mustNotMap": "city",
      "reason": "所在地点（现居城市）与期望工作地点是两个字段，不能互相回填"
    }
  ],
  "optionMatching": {
    "degree": {
      "硕士": [
        "硕士",
        "硕士研究生",
        "硕士（Master）"
      ],
      "博士": [
        "博士",
        "博士研究生",
        "博士（Doctorate/PHD）"
      ],
      "本科": [
        "本科",
        "本科（Bachelor）"
      ],
      "专科": [
        "专科",
        "专科（Associate）"
      ]
    },
    "studyForm": {
      "全日制": [
        "全日制",
        "统招全日制",
        "全日制普通高等教育"
      ]
    },
    "rule": "选项匹配不能删除修读形式限定；例如“非全日制硕士研究生”不能匹配“硕士”。"
  },
  "matching": {
    "exactAliasFirst": true,
    "fuzzyMinScore": 0.85,
    "fuzzyMinMargin": 0.25,
    "fuzzyRequiresUserCheck": true
  }
}
